---

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Right-hand bracket label, e.g. `About`, `Experience`, `Services`, `FAQ`. */
  tag: string;
}

const { render = true, tag } = Astro.props;
---
{
  render && (
    <div class="sec-head">
      <p class="label">{tag}</p>
      <span class="rule" aria-hidden="true" />
    </div>
  )
}
